# Application
APP_ENV=development
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8501
LOG_LEVEL=INFO

# Model provider
OPENAI_API_KEY=replace-with-openai-api-key

# Pinecone (cloud and region are needed only when provisioning an index)
PINECONE_API_KEY=replace-with-pinecone-api-key
PINECONE_INDEX_NAME=replace-with-index-name
PINECONE_CLOUD=aws
PINECONE_REGION=replace-with-pinecone-region

# AWS (use an IAM role on EC2 rather than static access keys)
AWS_REGION=replace-with-aws-region
S3_BUCKET_NAME=replace-with-bucket-name
# Optional for local development; leave blank on EC2 so the instance role is used.
AWS_PROFILE=

# RDS MySQL
DATABASE_URL=mysql+pymysql://user:password@host:3306/database
# Local path; Docker Compose overrides this with its read-only container mount.
DB_SSL_CA_PATH=certs/global-bundle.pem

# Authentication (generate a random value of at least 32 characters)
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# JSON array containing username, employee_id, password_salt, password_hash, and role
AUTH_USERS_JSON=replace-with-json-user-records
AUTH_TOKEN_TTL_SECONDS=1800

# Optional model and retrieval tuning
CHAT_PROVIDER=openai
OPENAI_CHAT_MODEL=replace-with-chat-model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024
PINECONE_NAMESPACE=
PINECONE_BATCH_SIZE=100
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_TOP_K=5
RETRIEVAL_MIN_SCORE=0.3
RAG_EVALUATION_ENABLED=false
