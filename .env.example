# Provider credentials (never commit real values)
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Repository and frontend
AWS_REGION=us-east-1
S3_BUCKET_NAME=
FASTAPI_URL=http://localhost:8000

# Authentication (generate a unique random value of at least 32 characters)
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=1800

# AWS RDS MySQL (use a least-privilege, read-only application user)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Model and retrieval configuration
CHAT_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_TOP_K=5
RETRIEVAL_MIN_SCORE=0.3
LOG_LEVEL=INFO
