{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListWorkAssistDocuments",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::WORKASSIST_BUCKET"
    },
    {
      "Sid": "ReadWorkAssistDocuments",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::WORKASSIST_BUCKET/*"
    }
  ]
}
